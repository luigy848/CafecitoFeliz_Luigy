PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nombre_de_tu_base

JWT_SECRET=genera_uno_con_el_comando_de_abajo
JWT_REFRESH_TOKEN=genera_otro_distinto
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Origen exacto del frontend que puede llamar a esta API (CORS).
# En local es Vite en :3000; en Render, la URL del Static Site.
CORS_ORIGIN=http://localhost:3000

# Contraseñas de los perfiles que crea `npm run seed:staff`.
# Si se omiten, el seed usa admin123 / caja123 (solo para desarrollo local).
SEED_ADMIN_PASSWORD=admin123
SEED_CASHIER_PASSWORD=caja123
